{
  "$schema": "https://opencode.ai/config.json",
  "model": "lemonade-local/Gemma-4-12B-it-MTP-GGUF",

  "tui": {
    "message_limit": 10000
  },

  // https://opencode.ai
  "agent": {
    "review": {
      "temperature": 0.1,
      "permission": {
        "edit": "deny"
      }
    },
    "analyze": {
      "temperature": 0.1,
      "permission": {
        "edit": "deny"
      }
    },
    "brainstorm": {
      "temperature": 0.7,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "plan": {
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "code-reviewer": {
      "temperature": 0.1,
      "prompt": "You are a code reviewer. Focus on security, performance, code quality and maintainability.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "temperature": 0.4,
      "top_p": 0.90,
      "min_p": 0.05,
      "repetition_penalty": 1.05,
      "frequency_penalty": 0.0,
      "presence_penalty": 0.0,
      "permission": {
        "external_directory": "deny",
        "doom_loop": "deny",
        "webfetch": "ask",
        // "webfetch": {
        //   "github.com/*": "allow",
        //   "docs.microsoft.com/*": "allow",
        //   "*": "ask"
        // }
        "glob": "allow",
        "view": "allow",
        "grep": "allow",

        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "write": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },

        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "npm run*": "allow",
          "npm test*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "npm publish*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "gh *": "deny",
          "ssh*": "deny",
          "scp*": "deny",
          "sftp*": "deny",
          "rsync*": "deny",
          "rm -rf*": "deny",
          "dotnet build*": "allow",
          "dotnet test*": "allow",
          "dotnet run*": "allow",
          "dotnet restore*": "allow",
          "dotnet watch*": "allow",
          "dotnet format*": "allow",
          "dotnet clean*": "allow",
          "dotnet list*": "allow",
          "dotnet sln*": "allow",
          "dotnet new*": "allow",
          "dotnet pack*": "allow",
          "dotnet ef migrations add*": "allow",
          "dotnet ef migrations list*": "allow",
          "dotnet --list-sdks*": "allow",
          "dotnet --list-runtimes*": "allow",
          "dotnet --version*": "allow",
          "dotnet add package*": "ask",
          "dotnet remove package*": "ask",
          "dotnet publish*": "ask",
          "dotnet ef database update*": "ask",
          "dotnet nuget push*": "deny",
          "dotnet nuget delete*": "deny",
          "dotnet tool install -g*": "deny"
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "buffer": 14000,      // 🎯 Prune/Compaction startar vid exakt 80% av maxContext!
    "keep": {
      "tokens": 8192       // Sparar de senaste 8k tokens efter rensningen
    }  
  },

  "instructions": [
    "DOTNET_CODING_GUIDELINES.md"
  ],

  "provider": {
    "lemonade-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade Local",
      "options": {
        "baseURL": "http://lemonade-server:13305/v1" // localhost would not work in Docker, use the service name instead
      },
      "models": {
        "Qwen3.6-14B-A3B-FableVibes-GGUF-Q4_K_M": {
          "name": "Qwen 3.6 14B",
          "limit": {
            "context": 70000, // OpenCode will automatically prune the context to this token limit.
            "output": 4096 // Sets  the maximum number of tokens the model can generate in a single response.
          }
        },
          "Gemma-4-12B-it-MTP-GGUF": {
          "name": "Gemma 4 12B",
          "limit": {
            "context": 29696, // 38912 - 8192 (output) - ~1024 margin [BASED ON LLM TOTAL CONTEXT OF 38912 TOKENS]
            "output": 8192    // 8k tokens for output, leaving 23k for context. This is a balance between context and output size.
          }
        }
      }
    }
  }
}