{
  "$schema": "https://opencode.ai/config.json",
  "model": "lemonade-local/Gemma-4-12B-it-MTP-GGUF", // Safe default - works well

  "tui": {
    "message_limit": 10000
  },

  // https://opencode.ai
  "agent": {
    "review": {
      "permission": {
        "edit": "deny"
      }
    },
    "analyze": {
      "permission": {
        "edit": "deny"
      }
    },
    "brainstorm": {
      "temperature": 1.0, // Raise temp for pure brainstorming, lower for more focused tasks
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "code-reviewer": {
      "prompt": "You are a code reviewer. Focus on security, performance, code quality and maintainability.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "prompt": "You are a senior .NET developer. You ensure code is of good quality and running as expected. You should ask the user for clarification if the requirements are unclear.",
      // Old defaults, below overrides model settings if set..
      // "temperature": 0.4,
      // "top_p": 0.90,
      // "min_p": 0.05,
      // "repetition_penalty": 1.05,
      // "frequency_penalty": 0.0,
      // "presence_penalty": 0.0,
      "permission": {
        "external_directory": "deny",
        "doom_loop": "deny",
        "webfetch": "ask",
        // "webfetch": {
        //   "github.com/*": "allow",
        //   "docs.microsoft.com/*": "allow",
        //   "*": "ask"
        // }
        "glob": "allow",
        "view": "allow",
        "grep": "allow",

        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "write": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },

        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "npm run*": "allow",
          "npm test*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "npm publish*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "gh *": "deny",
          "ssh*": "deny",
          "scp*": "deny",
          "sftp*": "deny",
          "rsync*": "deny",
          "rm -rf*": "deny",
          "dotnet build*": "allow",
          "dotnet debug*": "allow",
          "dotnet test*": "allow",
          "dotnet run*": "allow",
          "dotnet restore*": "allow",
          "dotnet watch*": "allow",
          "dotnet format*": "allow",
          "dotnet clean*": "allow",
          "dotnet list*": "allow",
          "dotnet sln*": "allow",
          "dotnet new*": "allow",
          "dotnet pack*": "allow",
          "dotnet ef migrations add*": "allow",
          "dotnet ef migrations list*": "allow",
          "dotnet --list-sdks*": "allow",
          "dotnet --list-runtimes*": "allow",
          "dotnet --version*": "allow",
          "dotnet add package*": "ask",
          "dotnet remove package*": "ask",
          "dotnet publish*": "ask",
          "dotnet ef database update*": "ask",
          "dotnet nuget push*": "deny",
          "dotnet nuget delete*": "deny",
          "dotnet tool install -g*": "deny"
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "buffer": 14000,      // 🎯 Prune/Compaction startar vid exakt 80% av maxContext!
    "keep": {
      "tokens": 8192       // Sparar de senaste 8k tokens efter rensningen
    }  
  },

  "instructions": [
    "DOTNET_CODING_GUIDELINES.md"
  ],

  "provider": {
    "lemonade-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade Local",
      "options": {
        "baseURL": "http://lemonade-server:13305/v1" // localhost would not work in Docker, use the service name instead
      },
      "models": {
        "Gemma-4-12B-it-MTP-GGUF": {
          "name": "Gemma 4 12B",
          "limit": {
            "context": 29696,
            "output": 8192
          },
          "options": { // Recommended defaults by https://unsloth.ai/docs/models/gemma-4
            "temperature": 1.0,
            "top_p": 0.95,
            "frequency_penalty": 0.0,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 64,
              "min_p": 0.0,
              "repetition_penalty": 1.0
            }
          }
        },
        "Gemma-4-26B-A4B-it-MTP-GGUF": { // Recommended for misc tasks by https://huggingface.co/unsloth/gemma-4-26B-A4B-it-GGUF
          "name": "Gemma 4 26B A4B it MTP GUF",
          "limit": {
            "context": 29696,
            "output": 8192
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "extraBody": {
              "top_k": 64
            }
          }
        },
        "Qwen3-Coder-30B-A3B-Instruct-GGUF": {
          "name": "Qwen 3 Coder 30B A3B Instruct",
          "limit": {
            "context": 29696,
            "output": 8192
          },
          "options": { // Per Qwen's own model card recommendations
            "temperature": 0.7,
            "top_p": 0.8,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.05
            }
          }
        },
        "Qwen3.6-35B-A3B-MTP-GGUF": {
          "name": "Qwen 3.6 35B A3B",
          "limit": {
            "context": 29696,
            "output": 8192
          },
          "options": { // Recommended by https://huggingface.co/Qwen/Qwen3.6-35B-A3B for coding tasks
            "temperature": 0.6,
            "top_p": 0.95,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.0
            }
          }
        }
      }
    }
  }
}