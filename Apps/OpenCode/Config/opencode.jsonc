{
  "$schema": "https://opencode.ai/config.json",
  "model": "lemonade-local/Gemma-4-12B-it-MTP-GGUF", // Safe default - works well
  "tui": {
    "message_limit": 10000
  },

  // https://opencode.ai
  "agent": {
    "review": {
      "permission": {
        "edit": "deny"
      }
    },
    "analyze": {
      "permission": {
        "edit": "deny"
      }
    },
    "brainstorm": {
      "temperature": 1.0, // Raise temp for pure brainstorming, lower for more focused tasks
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "code-reviewer": {
      "prompt": "You are a code reviewer. Focus on security, performance, code quality and maintainability.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "prompt": "You are a senior .NET developer. You ensure code is of good quality and running as expected. You should ask the user for clarification if the requirements are unclear.",
      // Old defaults, below overrides model settings if set..
      // "temperature": 0.4,
      // "top_p": 0.90,
      // "min_p": 0.05,
      // "repetition_penalty": 1.05,
      // "frequency_penalty": 0.0,
      // "presence_penalty": 0.0,
      "permission": {
        "external_directory": "deny",
        "doom_loop": "deny",
        "webfetch": "ask",
        // "webfetch": {
        //   "github.com/*": "allow",
        //   "docs.microsoft.com/*": "allow",
        //   "*": "ask"
        // }
        "glob": "allow",
        "view": "allow",
        "grep": "allow",

        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "write": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "package-lock.json": "ask",
          "yarn.lock": "ask",
          "pnpm-lock.yaml": "ask"
        },

        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },

        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "npm run*": "allow",
          "npm test*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "npm publish*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "gh *": "deny",
          "ssh*": "deny",
          "scp*": "deny",
          "sftp*": "deny",
          "rsync*": "deny",
          "rm -rf*": "deny",
          "dotnet build*": "allow",
          "dotnet debug*": "allow",
          "dotnet test*": "allow",
          "dotnet run*": "allow",
          "dotnet restore*": "allow",
          "dotnet watch*": "allow",
          "dotnet format*": "allow",
          "dotnet clean*": "allow",
          "dotnet list*": "allow",
          "dotnet sln*": "allow",
          "dotnet new*": "allow",
          "dotnet pack*": "allow",
          "dotnet ef migrations add*": "allow",
          "dotnet ef migrations list*": "allow",
          "dotnet --list-sdks*": "allow",
          "dotnet --list-runtimes*": "allow",
          "dotnet --version*": "allow",
          "dotnet add package*": "ask",
          "dotnet remove package*": "ask",
          "dotnet publish*": "ask",
          "dotnet ef database update*": "ask",
          "dotnet nuget push*": "deny",
          "dotnet nuget delete*": "deny",
          "dotnet tool install -g*": "deny"
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "buffer": 14000,      // 🎯 Prune/Compaction startar vid exakt 80% av maxContext!
    "keep": {
      "tokens": 8192       // Sparar de senaste 8k tokens efter rensningen
    }  
  },

  "instructions": [
    "Answer directly, after thinking. Lead with the answer, then only what it needs to be correct and usable.",
    "NEVER: open with preamble or pleasantries; restate the question; add filler transitions; hedge with niceties; or repeat a point you've already made.",
    "ALWAYS: keep essential steps, caveats, uncertainties, and specifics — never drop correctness or a needed warning for brevity.",
    "Keep the final answer lean. Use the least structure that conveys it (plain prose when short; lists or code only when they earn their place).",
    "If genuinely uncertain, say so and explain why — never omit uncertainty for the sake of brevity.",
    "If a user request is genuinely ambiguous, ask a sharp question, don't guess.",
    "Follow guidelines in DOTNET_CODING_GUIDELINES.md for .net development, UNLESS the user requests something else explicitly."
  ],

  "provider": {
    "lemonade-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade Local",
      "options": {
        "baseURL": "http://lemonade-server:13305/v1" // localhost would not work in Docker, use the service name instead
      },
      "models": {
        "Gemma-4-12B-it-MTP-GGUF": {
          "name": "Gemma 4 12B",
          "limit": {
            "context": 32300,
            "output": 8192
          },
          "options": { // Recommended defaults by https://unsloth.ai/docs/models/gemma-4
            "temperature": 1.0,
            "top_p": 0.95,
            "frequency_penalty": 0.0,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 64,
              "min_p": 0.0,
              "repetition_penalty": 1.0
            }
          }
        },
        "Gemma-4-26B-A4B-it-MTP-GGUF": { // Recommended for misc tasks by https://huggingface.co/unsloth/gemma-4-26B-A4B-it-GGUF
          "name": "Gemma 4 26B A4B it MTP GUF",
          "limit": {
            "context": 32300,
            "output": 8192
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "extraBody": {
              "top_k": 64
            }
          }
        },
        "Qwen3-Coder-30B-A3B-Instruct-GGUF-UD-Q4_K_XL": {
          "name": "Qwen 3 Coder 30B A3B Instruct (UD-Q4_K_XL)",
          "limit": {
            "context": 49000,
            "output": 8192
          },
          "options": { // Per Qwen's own model card recommendations
            "temperature": 0.7,
            "top_p": 0.8,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.05
            }
          }
        },
        // "Qwen3.6-35B-A3B-MTP-GGUF": { // Decommisioned in favor of the UD-Q4_K_XL variant, which is smaller and faster with better reasoning performance.
        //   "name": "Qwen 3.6 35B A3B",
        //   "limit": {
        //     "context": 49000,
        //     "output": 8192
        //     //"context": 29696,
        //     //"output": 8192
        //   },
        //   "options": { // Recommended by https://huggingface.co/Qwen/Qwen3.6-35B-A3B for coding tasks
        //     "temperature": 0.6,
        //     "top_p": 0.95,
        //     "presence_penalty": 0.0,
        //     "extraBody": {
        //       "top_k": 20,
        //       "min_p": 0.0,
        //       "repetition_penalty": 1.0
        //     }
        //   }
        // },
        "Qwen3.6-35B-A3B-GGUF-UD-Q4_K_XL": {
          "name": "Qwen 3.6 35B A3B UD-Q4_K_XL",
          "limit": {
            "context": 65536,
            "output": 16384 // generous headroom — thinking traces eat into this budget before the answer starts
          },
          "options": { // Qwen-recommended settings for precise/agentic coding, thinking mode
            "temperature": 0.6,
            "top_p": 0.95,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.0,
              "reasoning_budget": 4096, // hard token cap on the <think> block — top-level, NOT nested in chat_template_kwargs
              "chat_template_kwargs": {
                "enable_thinking": true,
                "preserve_thinking": false
              }
            }
          }
        },
        "Qwen3.8-27B-GGUF-UD-IQ3_XXS": { // Dense model which wont fit 16GB VRAM with Q4 quantization, gets VERY slow when offloading. Q3 XXS to keep it on VRAM.
          "name": "Qwen 3.8 27B UD-IQ3_XXS",
          "limit": {
            "context": 32600,
            "output": 8192
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.0,
              "chat_template_kwargs": {
                "reasoning_effort": "medium",
                "preserve_thinking": true
              }
            }
          }
        },
        "Qwen3.8-27B-GGUF-UD-Q4_K_XL": { // Accuracy alternative to the above, with Q4. MUCH slower than the IQ3_XXS variant, but can handle larger contexts and is more accurate for reasoning tasks.
          "name": "Qwen 3.8 27B UD-Q4_K_XL",
          "limit": {
            "context": 65530,
            "output": 16384
          },
          "options": {
            "temperature": 0.6, // lower than Qwen's documented thinking-mode default (1.0) — kept low for coding precision, same convention as your 3.6 config
            "top_p": 0.95,
            "presence_penalty": 0.0,
            "extraBody": {
              "top_k": 20,
              "min_p": 0.0,
              "repetition_penalty": 1.0,
              "chat_template_kwargs": {
                "reasoning_effort": "medium", // real graduated control on 3.8 — xhigh (default) / medium / low / none
                "preserve_thinking": false
              }
            }
          }
        }
      }
    }
  }
}