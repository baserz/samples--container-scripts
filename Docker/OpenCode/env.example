# Kopiera till ".env" och fyll i.

# Kör `id -u` och `id -g` på hosten och sätt samma värden här, så att filer
# som opencode skapar i /home/base/OpenWork/src får rätt ägare.
UID=1000
GID=1000

# Lösenord för OpenCode web-UI (obligatoriskt eftersom servern binder 0.0.0.0)
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_SERVER_USERNAME=opencode

# LLM-providernycklar - fyll bara i de ni faktiskt tänker använda.
# Kan också lämnas tomma och sättas via /connect inne i containern istället.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
